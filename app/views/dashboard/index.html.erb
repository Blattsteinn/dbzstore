    <div class="dashboard-grid">
      <div class="dashboard-card">
        <div class="card-header">
          <h3>Recent Orders</h3>
          <%= link_to "View all →", dashboard_orders_path %>
        </div>
        <div class="card-body">
          <% if @recent_orders.any? %>
            <table class="dash-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Email</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Insta</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_orders.each do |order| %>
                  <tr>
                    <td><%= link_to order.public_id&.first(12), dashboard_order_path(order), class: "mono-link" %></td>
                    <td class="cell-truncate"><%= order.email %></td>
                    <td><span class="status-badge status-<%= order.status %>"><%= order.status %></span></td>
                    <td><%= order.created_at.strftime("%m-%d, %H:%M") %></td>
                    <td><%= order.discord %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="empty-state">No orders yet.</p>
          <% end %>
        </div>
      </div>


    </div>
  </main>
</div>