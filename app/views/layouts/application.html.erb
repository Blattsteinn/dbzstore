<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Account Rift" %></title>
    <meta name="description" content="<%= content_for(:meta_description) || "Buy game accounts and in-game items instantly — secure Stripe checkout and fast email delivery at Account Rift." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Account Rift">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="preload" href="<%= asset_path("inter.woff2") %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%= asset_path("orbitron.woff2") %>" as="font" type="font/woff2" crossorigin>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="48x48">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">

    <%# Global CSS: needed on every storefront page. Page-specific CSS loads per-view via content_for(:head). %>
    <% if admin_page? %>
      <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <% else %>
      <%= stylesheet_link_tag "reset", "application", "nav", "fonts",
                              "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
    <%# Per-page styles load after globals so they can override them. %>
    <%= yield :head %>
  </head>

  <body class="<%= controller_name %>-<%= action_name %>">

    <nav class="site-nav" data-controller="nav" aria-label="Main navigation">
      <%= link_to "ACCOUNT RIFT", games_path, class: "nav-brand", aria: { label: "Account Rift home" } %>

      <button type="button" class="nav-toggle" data-action="nav#toggleMenu" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-nav-links">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <div class="nav-links" id="site-nav-links" data-nav-target="menu">
        <div class="nav-dropdown" data-nav-target="dropdown">
          <button type="button" class="nav-link nav-dropdown-trigger<%= " is-active" if params[:game].present? || nav_active?("games") %>" data-nav-target="dropdownTrigger" data-action="nav#toggleDropdown" aria-haspopup="true" aria-expanded="false">
            <%= params[:game].present? ? params[:game].capitalize : "Games" %>
            <svg class="nav-caret" width="8" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-dropdown-menu" data-nav-target="dropdownMenu" role="menu">
            <%= link_to "All Games", games_path, class: "nav-dropdown-item#{params[:game].blank? ? " is-active" : ""}" %>
            <% navigation_games.each do |game| %>
              <%= link_to game.official_name.presence || game.name.capitalize, game_products_path(game.name), class: "nav-dropdown-item#{params[:game] == game.name ? " is-active" : ""}" %>
            <% end %>
          </div>
        </div>

        <%= link_to "Products", (params[:game].present? ? game_products_path(params[:game]) : games_path), class: "nav-link#{nav_active?("products") ? " is-active" : ""}" %>
        <%= link_to "Support", new_support_message_path, class: "nav-link#{nav_active?("support_messages") ? " is-active" : ""}" %>
        <%= link_to "FAQ", faqs_path, class: "nav-link#{nav_active?("faqs") ? " is-active" : ""}" %>

        <% if user_signed_in? && current_user.admin? %>
          <%= link_to "Dashboard", dashboard_path, class: "nav-link#{nav_active?("dashboard") ? " is-active" : ""}" %>
        <% end %>
      </div>
    </nav>

    <% flash.each do |type, message| %>
      <% 
        alert_class = case type.to_s
                      when "notice", "success"
                        "alert-success"
                      when "alert", "error"
                        "alert-error"
                      else
                        "alert-info"
                      end
      %>
      <div class="alert <%= alert_class %>">
        <span class="alert-icon">
          <% if alert_class == "alert-success" %>✅<% elsif alert_class == "alert-error" %>❌<% else %>ℹ️<% end %>
        </span>
        <span><%= message %></span>
      </div>
    <% end %>
        
    <%= yield %>
    
    <footer class="site-footer">
      <span>&copy; <%= Time.current.year %> Account Rift</span>
      <%= link_to "Games", games_path %>
      <%= link_to "FAQ", faqs_path %>
      <%= link_to "Support", new_support_message_path %>
      <%= link_to "Feedback", feedbacks_path %>
      <%= link_to "Delivery", instructions_path %>
      <%= link_to "Terms of Service", tos_path %>
      <%= link_to "Privacy Policy", privacy_path %>
    </footer>
  </body>
</html>
