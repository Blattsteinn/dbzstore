<% content_for :head do %>
  <%= stylesheet_link_tag "discounts" %>
<% end %>

<%= render "shared/errors", object: @discount %>

<div class="discount-form">
  <div class="discount-header">
    <h1>Edit Discount</h1>
    <p><%= link_to "← back to all", dashboard_discounts_path %></p>
  </div>

  <%= form_with model: @discount do |form| %>
    <div class="card">
      <div class="field">
        <%= form.label :code %>
        <%= form.text_field :code %>
      </div>

      <div class="field">
        <%= form.label :amount %>
        <%= form.number_field :amount %>
      </div>

      <div class="field">
        <%= form.label :remaining %>
        <%= form.number_field :remaining %>
      </div>
    </div>

    <div class="submit-row">
      <%= form.submit "Update Discount" %>
    </div>
  <% end %>
</div>