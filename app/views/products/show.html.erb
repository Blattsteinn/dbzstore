<% content_for :head do %>
  <%= stylesheet_link_tag "product/product_hero", "product/product_view",
                          "product/instant_checkout", "discounts" %>
<% end %>

<% content_for(:title) { "#{@product.title} — Account Rift" } %>
<% content_for(:meta_description) { "Buy \"#{@product.title}\" for #{@game.official_name}. Instant email delivery with secure Stripe checkout at Account Rift." } %>

<div class="product-hero-wrapper">

  <%= link_to "← Back", game_products_path(@game.name), class: "hero-back-link" %>

  <%# Large banner image at the top  %>
  <div class="product-hero-stage" data-controller="product-view">
      <%= image_tag @product.hero_image, class: "product-hero-bg", alt: @product.title, id: "hero-bg-image", fetchpriority: "high",
          style: "cursor: zoom-in",
          data: { action: "click->product-view#openLightbox", product_view_target: "image" } if @product.hero_image %>

    <div class="product-hero-overlay"></div>

    <div class="product-hero-content">
      <span class="hero-badge"><%= @game.name %></span>
      <h1><%= @product.title %></h1>
    </div>

  </div>

  <%# ---- Detail section ---- %>
  <div class="product-hero-detail">
    <div class="product-hero-detail-grid">

      <div class="hero-desc-panel" id="hero-description"
           data-controller="language-switcher"
           data-language-switcher-languages-value='["en","es","fr","de","it"]'>

        <%# Language switcher %>
        <%= render 'products/language_switcher' %> 
      
        <%# Gallery — always shown, click to open fullscreen %>
        <%= render 'products/image_gallery' %>

        <%# Description %>
        <div class="hero-desc-body">
          <%# Contact block is literal HTML (not markdown) so the email address is NOT
              auto-linked as a naked anchor — the only link has descriptive text. %>
          <h2>Contact (if no email received)</h2>
          <ul>
            <li>Instagram / Discord: @dokkanarnis</li>
            <li>Email: dokkanriftmanagement@tuta.com — <a href="mailto:dokkanriftmanagement@tuta.com" target="_blank" rel="noopener noreferrer">send us an email</a></li>
          </ul>
        </div>

      </div>

      <div class="hero-purchase-panel" id="hero-purchase">
        <p class="panel-title">Select variant &amp; purchase</p>
      
        <%# Purchase panel %>
        <%= render 'products/purchase_panel' %>

        <%# Discount form %>
        <%= render 'products/discount_form' %>

      </div>
      

    </div>
  </div>

  <%# Stripe redirect loading overlay %>
  <%= render 'products/stripe_loading' %>

</div>


