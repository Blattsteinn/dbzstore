<div class="hero-purchase-panel" id="hero-purchase">
    <p class="panel-title">Select variant &amp; purchase</p>

<%= form_with url: orders_path, method: :post, data: { turbo: false, controller: "checkout-form", action: "submit->checkout-form#submit" },
        html: { class: "hero-purchase-form" } do |form| %>

        <%= form.text_field :contact_me_by_fax_only, 
        style: "position:absolute;left:-9999px;", 
        tabindex: "-1", 
        autocomplete: "off", hidden: true%>

    <div class="hero-variant-list">
    <% @product.variants.each do |variant| %>
        <% next if variant.stock <= 0 %>
        <label class="hero-variant-option" data-price="<%= convert_from_cents(variant.price) %>">
        <%= form.radio_button :variant_id, variant.id, required: true %>
        <div class="hero-variant-info">
            <p class="v-name"><%= variant.title %></p>
        </div>
        <div>
            <p class="hero-variant-price"><%= convert_from_cents(variant.price) %>€</p>
            <p class="hero-variant-stock"><%= variant.stock %> in stock</p>
        </div>
        </label>
    <% end %>
    </div>

    <%= form.hidden_field :quantity, value: 1 %>

        <%= form.label :email, "Email (required)" %>
        <%= form.email_field :email, placeholder: "you@example.com", required: true,
        data: { action: "focus->checkout-form#positionEmailField" } %>

    <%= form.label :discord, "Instagram / Discord (optional)" %>
    <%= form.text_field :discord, placeholder: "username" %>

    <%# Payment method badges — drop these PNGs into app/assets/images/ %>
    <div class="hero-payment-badges">
    <span class="hero-payment-label">Supported methods:</span>
    <span class="payment-badge">
        <%= image_tag 'visa.png', alt: 'Visa', loading: "lazy", class: 'payment-logo--paypal-pay' %>
    </span>
    <span class="payment-badge">
        <%= image_tag 'mastercard.png', alt: 'Mastercard', loading: "lazy" %>
    </span>
    <span class="payment-badge">
        <%= image_tag 'paypal.png', alt: 'PayPal', loading: "lazy",  class: 'payment-logo--paypal-pay' %>
    </span>
    <span class="payment-badge">
        <%= image_tag 'apple-pay.png', alt: 'Apple Pay', class: 'payment-logo--apple-pay', loading: "lazy" %>
    </span>
    <span class="payment-badge">
        <%= image_tag 'google-pay.png', alt: 'Google Pay', class: 'payment-logo--google-pay', loading: "lazy" %>
    </span>
    </div>

    <%= button_tag type: 'submit', class: 'hero-checkout-btn' do %>
    Continue to secure payment
    <% end %>

    <p class="hero-payment-methods">
    🔒 Secure checkout powered by Stripe
    </p>
<% end %>
</div>