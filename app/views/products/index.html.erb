

<% content_for :head do %>
  <%= stylesheet_link_tag "product/product_index", "banner" %>
<% end %>

<% content_for(:title) { "#{@game.official_name} Accounts — Account Rift" } %>
<% content_for(:meta_description) { "Buy #{@game.official_name} accounts and in-game items at Account Rift. Instant email delivery, secure Stripe checkout, and support before and after your order." } %>

<div id="product-index-page">

  <div id="games-banner">
    <img src="/banner.jpg" loading="lazy" alt="banner image for the store">
    <div class="banner-overlay">
      <h1 class="banner-title"><%= @game.official_name %> accounts </h1>
      <p class="banner-discord">Instagram / Discord: @dokkanarnis</p>
    </div>
  </div>

  <% if @products.empty? %>
    <div class="empty-state">
      <p class="empty-state-icon">📭</p>
      <p class="empty-state-text">No products found</p>
      <% if params[:product_name].present? %>
      
        <p class="empty-state-hint">Try a different search term or <%= link_to "browse all products", 
        game_products_path(@game.name) %></p>

      <% else %>
        <p class="empty-state-hint">Check back soon — new products are on the way!</p>
      <% end %>
    </div>
  <% end %>

  <div id="product-container">
    <% @products.each do |product| %>
      <%= link_to game_product_path(@game.name, product), class: "product-box" do %>

        <div class="product-box-img">
          <%= image_tag product.thumbnail, class: "product-box-img-img", alt: product.title, loading: "lazy" if product.primary_image %>
          <% if product.hot? %>
            <span class="hot-tag">Hot</span>
          <% end %>
        </div>

        <div class="product-box-body">
          <p class="product-title"><%= product.title %></p>

          <div class="product-box-footer">
            <%# Taking first, the price will match anyway %>
            <p class="product-price"><%= convert_from_cents(product.variants.first&.price) %> EUR</p>
            <p class="product-stock"><%= product.variants.sum(&:stock) %> in stock</p>
          </div>
        </div>

      <% end %>

    <% end %>
  </div>

</div>