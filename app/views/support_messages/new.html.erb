<% content_for :head do %>
  <%= stylesheet_link_tag "support_messages" %>
<% end %>

<% content_for(:title) { "Contact Support — Account Rift" } %>
<% content_for(:meta_description) { "Having an issue with your order? Contact Account Rift support via Discord, Instagram, or the contact form — replies usually within 24 hours." } %>

<div id="support-message-new-page">
  <div class="support-form-card">

    <div class="feedback-form-header">
      <h1>Contact Support</h1>
      <p>Having an issue with your order? Contact me on Discord / Instagram (@dokkanarnis) or fill in the form below and we'll get back to you — usually within 24 hours.</p>
      <p>For the fastest response, include your order ID and the operating system of your device (iOS or Android).</p>
    </div>

    <% if @support_message.errors.any? %>
      <div class="feedback-errors">
        <strong>Please fix the following:</strong>
        <ul>
          <% @support_message.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @support_message, class: "support-form" do |form| %>
      <div style="position: absolute; left: -9999px;" hidden="true">
        <%= text_field_tag :contact_me_by_fax_only, nil, tabindex: -1, autocomplete: "off" %>
      </div>

      <div class="form-group">
        <%= form.label :title, "Subject" %>
        <%= form.text_field :title, class: "form-input", placeholder: "Brief description of your issue" %>
      </div>

      <div class="form-group">
        <%= form.label :email, "Your Email" %>
        <%= form.email_field :email, class: "form-input", placeholder: "you@example.com" %>
      </div>

      <div class="form-group">
        <%= form.label :public_id, "Order ID (optional)" %>
        <p class="form-hint">Leave blank if not related to a specific order.</p>
        <%= form.text_field :public_id, class: "form-input form-input--short" %>
      </div>

      <div class="form-group">
        <%= form.label :message, "Message" %>
        <%= form.textarea :message, rows: 6, class: "form-input", placeholder: "Describe your issue in detail...", maxlength: 1000 %>
      </div>

      <div class="form-actions">
        <%= link_to "Cancel", games_path, class: "btn-cancel" %>
        <%= form.submit "Send Message", class: "btn-submit" %>
      </div>

    <% end %>
  </div>
</div>