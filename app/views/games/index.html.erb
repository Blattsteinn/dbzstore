

<% content_for(:title) { "Account Rift — Buy Game Accounts & Items" } %>
<% content_for(:meta_description) { "Buy game accounts and in-game items instantly at Account Rift. Secure Stripe checkout, fast email delivery, and real customer support." } %>

<div id="games-index-page">

  <div id="games-banner">
    <div class="banner-overlay">
      <h1 class="banner-title">Account Rift</h1>
      <p class="banner-subtitle">Premium game accounts — safe, fast, and trusted by thousands of gamers worldwide.</p>
      <p class="banner-discord">Discord / Instagram: @dokkanarnis</p>
    </div>
  </div>

  <div class="games-intro">
    <p>Account Rift is a marketplace for game accounts and in-game items. Every order is paid through Stripe checkout and delivered by email — no account registration is required, and delivery instructions are included with your purchase.</p>
    <% if @games.any? %>
      <p>We currently offer accounts for <%= @games.map { |g| g.official_name.presence || g.name }.join(" and ") %>. All products are manually checked before listing, and new stock is added regularly — if you don't see what you're looking for, check back soon or contact support.</p>
    <% end %>
    <ul>
      <li>Instant email delivery (usually within 15–60 minutes)</li>
      <li>Secure payments via Stripe</li>
      <li>Support via Instagram, Discord, or the contact form</li>
    </ul>
    <p>Have questions before buying? Message @dokkanarnis on Instagram or Discord, or use the contact form on the Support page — we usually reply within 24 hours and are happy to help you choose the right account.</p>
  </div>

  <% if @games.any? %>
    <div class="games-section-header">
      <h2>Choose Your Game</h2>
      <p>Select a game to browse available accounts</p>
    </div>

    <div id="games-container">
    <%# Yes DB query in views, 
      but not the end of the world, rarely visited page now anyway  #%>
      <% @games.each do |game| %>
        <%= link_to game_products_path(game.name), class: "game-card" do %>
          <div class="game-card-image">
            <%= image_tag "#{game.name}.jpg", alt: game.official_name, onerror: "this.style.display='none'", loading: "lazy"  %>
          </div>
          <span class="game-card-name"><%= game.official_name %></span>
          <span class="game-card-hint">Browse Accounts →</span>
        <% end %>

      <% end %>
    </div>
  <% else %>
    <div id="games-container">
      <div class="empty-state">
        <p class="empty-state-icon">🎮</p>
        <p class="empty-state-text">No games available yet</p>
        <p class="empty-state-hint">Check back soon — new games are on the way!</p>
      </div>
    </div>
  <% end %>

</div>
