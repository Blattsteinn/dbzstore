<% content_for :head do %>
  <%= stylesheet_link_tag "faqs" %>
<% end %>

<% content_for(:title) { "Frequently Asked Questions — Account Rift" } %>
<% content_for(:meta_description) { "Answers to common questions about ordering, delivery, refunds, and support at Account Rift." } %>

<div class="faq">
  <div class="faq-header">
    <h1>Frequently Asked Questions</h1>
  </div>

  <% if @faqs.any? %>
    <% @faqs.each do |faq| %>
      <details class="card faq-item">
        <summary><%= faq.question %></summary>
        <div class="faq-answer"><%= faq.answer %></div>
      </details>
    <% end %>
  <% else %>
    <p class="faq-empty">No FAQs available yet.</p>
  <% end %>

  <% if current_user&.admin? %>
    <%= link_to "Manage FAQs (Admin) →", dashboard_faqs_path, class: "faq-admin-link" %>
  <% end %>
</div>